# ========================================================
# LeadFlow CRM - Environment Variables Example
# Copy this file to backend/.env and configure values
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow_crm

# JWT Authentication
JWT_SECRET=leadflow_crm_super_secret_jwt_key_evaluation_2026
JWT_EXPIRES_IN=7d

# CORS Configuration (Allowed frontend origin)
CLIENT_URL=http://localhost:5173
